+# ====================================================
+# 功能 5：修改备注（v1.2 新增）
+# 只改备注，不触碰端口/IP，不重建防火墙放行，风险最低。
+# ====================================================
+do_note() {
+    echo ""
+    load_rules
+
+    if [[ ${#RULES[@]} -eq 0 ]]; then
+        info "当前没有端口转发规则，请先新增。"
+        return
+    fi
+
+    printf "\n\033[1m%-6s %-10s %-10s    %-22s %s\033[0m\n" "序号" "协议" "本机端口" "目标地址" "备注"
+    echo "──────────────────────────────────────────────────────────────"
+
+    local idx=1
+    local rule lport dip dport remark
+    for rule in "${RULES[@]}"; do
+        IFS='|' read -r lport dip dport remark <<< "$rule"
+        printf "%-6s %-10s %-10s -> %-22s %s\n" \
+            "$idx" "tcp+udp" "$lport" "${dip}:${dport}" "${remark:--}"
+        ((idx++))
+    done
+    echo ""
+
+    local choice
+    read -rp "请输入要修改备注的序号 (0 取消): " choice
+    if [[ "$choice" == "0" ]] || [[ -z "$choice" ]]; then
+        info "已取消。"
+        return
+    fi
+    if [[ ! "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#RULES[@]} )); then
+        err "无效的序号。"
+        return
+    fi
+
+    local target="${RULES[$((choice-1))]}"
+    IFS='|' read -r lport dip dport remark <<< "$target"
+
+    local new_note
+    read -rp "请输入新备注 (当前: ${remark:--}，直接回车清空): " new_note
+    new_note=$(sanitize_note "$new_note")
+
+    if [[ "$new_note" == "$remark" ]]; then
+        info "备注未变化，无需修改。"
+        return
+    fi
+
+    backup_conf
+    RULES[$((choice-1))]="${lport}|${dip}|${dport}|${new_note}"
+
+    if ! write_conf_file; then
+        # 写入失败则回滚内存状态，避免后续操作基于脏数据
+        RULES[$((choice-1))]="${lport}|${dip}|${dport}|${remark}"
+        return
+    fi
+
+    if reload_rules; then
+        info "备注已更新: ${lport} → ${dip}:${dport}  [${new_note:--}]"
+        log_action "更新备注: ${lport} -> ${new_note:-(空)}"
     else
         err "规则加载失败，请检查配置。"
     fi
 }
 
