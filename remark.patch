+# ============== 备注净化 ==============
+# 备注是用户自由文本，会进入两处：RULES 数组（| 分隔）与 nft 配置文件的行尾注释。
+# 因此剔除会破坏数据结构的字符：分隔符 |、换行、反引号与 $（配置由 printf 写出，
+# 但仍提前剔除，避免任何解析层被注入）、反斜杠与双引号（防止将来改用内核 comment 时出错）。
+sanitize_note() {
+    local s="$1"
+    s="${s//$'\r'/}"
+    s="${s//$'\n'/}"
+    s="${s//|//}"
+    s="${s//\`/}"
+    s="${s//\$/}"
+    s="${s//\\/}"
+    s="${s//\"/}"
+    # 去掉首尾空白
+    s="${s#"${s%%[![:space:]]*}"}"
+    s="${s%"${s##*[![:space:]]}"}"
+    # 限长
+    s="${s:0:${NOTE_MAX_LEN}}"
+    printf '%s' "$s"
+}
